# Die echten Zugangsdaten. Dieses Repository ist oeffentlich -- was hier
# hineinrutscht, ist veroeffentlicht, auch wenn es gleich wieder entfernt wird.
.env
.env.*
!.env.example

**/__pycache__/
**/node_modules/
*.pyc

# Werkstattstaende der Vorlagen
werkzeug/neu/
werkzeug/tpl/
werkzeug/tpl_fotos/
werkzeug/out/

# Uniform ist lizenzpflichtig. Zum Bauen muessen die Schnitte hier liegen --
# veroeffentlicht werden duerfen sie nicht. Die Regel steht hier, damit ein
# `git add -A` sie nicht doch einsammelt.
werkzeug/fonts/*.ttf
werkzeug/fonts/*.otf
werkzeug/fonts/*.woff2
website/schrift/
werkzeug/node_modules/
werkzeug/package-lock.json
