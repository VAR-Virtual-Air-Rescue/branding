# Zugangsdaten und Einstellungen des Anmeldedienstes.
#
#   cp .env.example .env    und die echten Werte eintragen
#
# `.env` steht in der .gitignore. Dieses Repository ist oeffentlich: ein
# einmal gepushtes Geheimnis ist verbrannt, auch wenn der naechste Commit es
# wieder entfernt -- es steht dann immer noch in der Historie.

# --- Hub -------------------------------------------------------------------
HUB_URL=https://hub.virtualairrescue.com

# Der Client "Branding" im Hub.
HUB_CLIENT_ID=5
HUB_CLIENT_SECRET=hier-das-echte-geheimnis-eintragen

# --- Diese Seite -----------------------------------------------------------
# Woraus die redirect_uri gebaut wird: <BRANDING_BASE_URL>/api/auth/callback.
# Der Hub prueft sie als Praefix gegen die hinterlegte Adresse, Unterpfade sind
# also erlaubt.
BRANDING_BASE_URL=https://branding.virtualairrescue.com

# Ohne diese Berechtigung kommt niemand herein. Der Hub prueft sie ebenfalls,
# bevor er die Zustimmungsseite zeigt -- geprueft wird trotzdem beides.
ERFORDERLICHE_PERMISSION=LOGIN_BRANDING

# --- Sitzung ---------------------------------------------------------------
# Signiert das eigene Sitzungscookie. Mindestens 32 Zeichen, sonst startet der
# Dienst nicht. Erzeugen mit:  openssl rand -hex 32
# Wird dieser Wert getauscht, sind alle bestehenden Sitzungen ungueltig.
SESSION_SECRET=

# Wie lange eine Anmeldung haelt. Kuerzer als die 30 Tage des Hub-Tokens.
SESSION_TAGE=7

# --- Betrieb ---------------------------------------------------------------
HUB_TIMEOUT_MS=8000
PORT=8080

# Nur fuer die Entwicklung ohne HTTPS: setzt Cookies ohne `Secure`.
# Im Betrieb weglassen.
# COOKIE_UNSICHER=1
